{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "manbhavan-productions-kappa.vercel.app"
        }
      ],
      "destination": "https://www.manbhavanproductions.com/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/" }
  ]
}
  